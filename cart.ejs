<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grill Restaurant</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
  :root {
    --bg: #f0f5f0;
    --white: #ffffff;
    --green: #1a7a4a;
    --green-light: #e8f5ee;
    --green-mid: #2ea865;
    --accent: #f4a828;
    --red: #e74c3c;
    --text: #1a1a2e;
    --muted: #8a9aaa;
    --border: #e8eef0;
    --shadow: 0 4px 24px rgba(26,122,74,0.10);
    --shadow-card: 0 2px 16px rgba(0,0,0,0.07);
  }
 
  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
 
  .app {
    background: var(--white);
    border-radius: 24px;
    width: 100%;
    max-width: 1100px;
    min-height: 640px;
    display: grid;
    grid-template-columns: 64px 1fr 300px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(26,122,74,0.12);
  }
 
  /* SIDEBAR */
  .sidebar {
    background: var(--white);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
    gap: 8px;
  }
  .logo-icon {
    width: 40px; height: 40px;
    background: var(--green-light);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    margin-bottom: 16px;
  }
  .nav-item {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: var(--muted);
    font-size: 18px;
    transition: all 0.2s;
    border: none; background: none;
  }
  .nav-item:hover, .nav-item.active {
    background: var(--green-light);
    color: var(--green);
  }
  .nav-item.active { color: var(--green); }
 
  /* MAIN */
  .main {
    padding: 24px 28px;
    overflow-y: auto;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .header-left .date { font-size: 12px; color: var(--muted); }
  .header-left h1 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    color: var(--text);
  }
  .search-bar {
    display: flex; align-items: center;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 14px;
    gap: 8px;
    flex: 1;
    max-width: 240px;
    margin: 0 16px;
  }
  .search-bar input {
    border: none; background: none; outline: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; color: var(--text);
    width: 100%;
  }
  .search-bar input::placeholder { color: var(--muted); }
 
  .section-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .section-header h2 { font-size: 17px; font-weight: 600; color: var(--text); }
  .view-all { font-size: 12px; color: var(--green); font-weight: 500; cursor: pointer; text-decoration: none; }
 
  /* CATEGORIES */
  .categories {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cat-btn {
    padding: 6px 16px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    background: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .cat-btn.active, .cat-btn:hover {
    background: var(--green);
    border-color: var(--green);
    color: white;
  }
 
  /* FOOD GRID */
  .food-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .food-card {
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    padding: 12px;
    transition: all 0.25s;
    position: relative;
    cursor: pointer;
  }
  .food-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--green-mid);
  }
  .food-card:hover .food-img { transform: scale(1.04); }
  .food-img-wrap {
    width: 100%; height: 100px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 10px;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    font-size: 52px;
  }
  .food-img { transition: transform 0.3s; width: 100%; height: 100%; object-fit: cover; }
  .wishlist-btn {
    position: absolute; top: 16px; right: 14px;
    width: 28px; height: 28px;
    background: white;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: none; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    font-size: 14px;
    transition: all 0.2s;
  }
  .wishlist-btn:hover { transform: scale(1.15); }
  .wishlist-btn.liked { color: var(--red); }
 
  .food-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .food-price { font-size: 13px; font-weight: 700; color: var(--green); float: right; }
  .food-desc { font-size: 11px; color: var(--muted); margin: 3px 0 6px; line-height: 1.4; }
  .food-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  .stars { font-size: 11px; color: var(--accent); }
  .rating { font-size: 11px; color: var(--muted); margin-left: 3px; }
  .add-btn {
    background: var(--green);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .add-btn:hover { background: var(--green-mid); transform: scale(1.03); }
  .add-btn:active { transform: scale(0.97); }
  .add-btn.added {
    background: var(--green-light);
    color: var(--green);
  }
 
  /* ORDER PANEL */
  .order-panel {
    background: var(--white);
    border-left: 1px solid var(--border);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
  }
  .order-header {
    display: flex; align-items: center; justify-content: space-between;
  }
  .order-header h2 { font-size: 17px; font-weight: 600; color: var(--text); }
  .close-btn {
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--bg);
    border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--muted); font-size: 14px;
  }
 
  .order-type {
    display: flex; gap: 6px;
  }
  .type-btn {
    padding: 5px 12px;
    border-radius: 20px;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; font-weight: 500;
    cursor: pointer;
    border: 1.5px solid var(--border);
    background: var(--white);
    color: var(--muted);
    transition: all 0.2s;
  }
  .type-btn.active {
    background: var(--green);
    border-color: var(--green);
    color: white;
  }
 
  /* CART ITEMS */
  .cart-items { display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .cart-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px;
    background: var(--bg);
    border-radius: 12px;
    animation: slideIn 0.3s ease;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .cart-img {
    width: 44px; height: 44px;
    border-radius: 10px;
    background: var(--white);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .cart-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
  .cart-info { flex: 1; min-width: 0; }
  .cart-name { font-size: 12px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cart-sub { font-size: 10px; color: var(--muted); }
  .cart-price { font-size: 12px; font-weight: 700; color: var(--green); }
  .cart-qty {
    display: flex; align-items: center; gap: 6px;
  }
  .qty-btn {
    width: 22px; height: 22px;
    border-radius: 6px;
    background: var(--white);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; color: var(--green); font-weight: 700;
    transition: all 0.15s;
  }
  .qty-btn:hover { background: var(--green); color: white; }
  .qty-val { font-size: 12px; font-weight: 600; color: var(--text); min-width: 16px; text-align: center; }
  .delete-btn {
    background: none; border: none; cursor: pointer;
    color: var(--red); font-size: 14px;
    opacity: 0.6; transition: opacity 0.2s;
  }
  .delete-btn:hover { opacity: 1; }
 
  .empty-cart {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px; color: var(--muted);
    font-size: 13px;
  }
  .empty-cart .emoji { font-size: 40px; }
 
  /* SUMMARY */
  .order-summary {
    border-top: 1px dashed var(--border);
    padding-top: 12px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .summary-row {
    display: flex; justify-content: space-between;
    font-size: 12px; color: var(--muted);
  }
  .summary-row.total {
    font-size: 14px; font-weight: 700;
    color: var(--text); margin-top: 4px;
  }
  .summary-row .discount { color: var(--red); }
  .summary-row .total-val { color: var(--green); }
 
  /* PAYMENT */
  .payment-section { }
  .payment-section h3 { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 10px; }
  .payment-options { display: flex; gap: 8px; margin-bottom: 14px; }
  .pay-btn {
    flex: 1;
    padding: 8px;
    border-radius: 10px;
    border: 1.5px solid var(--border);
    background: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; font-weight: 600;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 4px;
  }
  .pay-btn.active {
    background: var(--text);
    border-color: var(--text);
    color: white;
  }
  .pay-btn:hover:not(.active) { border-color: var(--green); color: var(--green); }
 
  .checkout-btn {
    width: 100%;
    background: var(--green);
    color: white;
    border: none;
    border-radius: 14px;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px; font-weight: 700;
    cursor: pointer;
    transition: all 0.25s;
    letter-spacing: 0.3px;
  }
  .checkout-btn:hover { background: var(--green-mid); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(26,122,74,0.25); }
  .checkout-btn:active { transform: translateY(0); }
  .checkout-btn:disabled { background: var(--muted); cursor: not-allowed; transform: none; box-shadow: none; }
 
  /* MODAL */
  .modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 100;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .modal-overlay.show { display: flex; }
  .modal {
    background: var(--white);
    border-radius: 24px;
    padding: 36px 32px;
    max-width: 360px;
    width: 90%;
    text-align: center;
    animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @keyframes popIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .modal .check { font-size: 56px; margin-bottom: 12px; }
  .modal h3 { font-family: 'Playfair Display', serif; font-size: 22px; color: var(--text); margin-bottom: 8px; }
  .modal p { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }
  .modal .order-num { font-size: 11px; color: var(--muted); background: var(--bg); padding: 6px 14px; border-radius: 20px; display: inline-block; margin-bottom: 20px; }
  .modal-close {
    background: var(--green); color: white;
    border: none; border-radius: 12px;
    padding: 12px 32px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .modal-close:hover { background: var(--green-mid); }
 
  /* TOAST */
  .toast {
    position: fixed; bottom: 24px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--text);
    color: white;
    padding: 10px 20px;
    border-radius: 20px;
    font-size: 13px; font-weight: 500;
    z-index: 200;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    white-space: nowrap;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }
 
  @media (max-width: 820px) {
    .app { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; }
    .sidebar { flex-direction: row; padding: 12px 20px; border-right: none; border-bottom: 1px solid var(--border); }
    .food-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
<body>
 
<div class="app">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="logo-icon">🍽️</div>
    <button class="nav-item active" title="Home">🏠</button>
    <button class="nav-item" title="Menu">⊞</button>
    <button class="nav-item" title="Orders">🕐</button>
    <button class="nav-item" title="Settings">⚙️</button>
    <button class="nav-item" title="Bookmarks" style="margin-top:auto;">🔖</button>
  </nav>
 
  <!-- MAIN MENU -->
  <main class="main">

  <% if (products.length === 0) { %>
    <h2>Your Cart is Empty 😢</h2>
  <% } %>

  <div class="food-grid">

    <% products.forEach(item => { %>

      <div class="food-card">

        <div class="food-img-wrap">
          <img src="/uploads/<%= item.image %>" class="food-img">
        </div>

        <div>
          <span class="food-name"><%= item.item_name %></span>
          <span class="food-price">₹ <%= item.price %></span>
        </div>

        <div class="food-desc"><%= item.description %></div>

        <div style="margin-top:10px;">
          <p>Qty: <b><%= item.qty %></b></p>
          <p>Total: ₹ <b><%= item.total %></b></p>
        </div>

      </div>

    <% }) %>

  </div>

  <% if (products.length > 0) { %>
    <div style="margin-top:20px;">
      <a href="/order" style="padding:12px 25px; background:green; color:white;">
        Proceed to Order 💳
      </a>
    </div>
  <% } %>

</main>
 
  
</div>
 
<!-- SUCCESS MODAL -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <div class="check">✅</div>
    <h3>Order Placed!</h3>
    <p>Your order is being prepared with love.<br>Estimated time: 25–30 minutes.</p>
    <div class="order-num" id="order-num">Order #000000</div>
    <button class="modal-close" onclick="closeModal()">Continue Ordering</button>
  </div>
</div>
 
<!-- TOAST -->
<div class="toast" id="toast"></div>
 

</body>
</html>